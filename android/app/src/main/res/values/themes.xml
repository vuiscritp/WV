<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Giao diện tối cố định duy nhất - không còn chọn theme/biến thể sáng-tối,
         khớp với thiết kế mockup (luôn dark chrome kiểu Chrome/Cốc Cốc). -->
    <style name="Theme.Egeo" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorPrimaryVariant">@color/app_primary_variant</item>
        <item name="colorSecondary">@color/app_accent</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <item name="chromeBackground">@color/app_chrome_bg</item>
        <item name="addressBarBackground">@color/app_address_bg</item>
        <item name="addressBarBorder">@color/app_address_border</item>
        <item name="iconMuted">@color/app_icon_muted</item>
        <item name="android:statusBarColor">@color/app_chrome_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

</resources>
