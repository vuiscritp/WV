<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dùng cho tìm kiếm bằng giọng nói (Web Speech API trong WebView) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Dùng cho Local API chạy nền (Phần 3) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EgeoApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Egeo"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Hồ sơ Mặc định: tiến trình chính của app, là launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          3 hồ sơ phụ: mỗi hồ sơ 1 tiến trình riêng (android:process=":pN") để
          WebView của Android tự cô lập thư mục dữ liệu (cookie/localStorage/cache)
          theo tiến trình. Không xuất ra launcher - chỉ mở qua ProfileManager từ
          trong app. Chỉ hoạt động đầy đủ trên Android 9 (API 28) trở lên; xem
          EgeoApplication + ProfileManager.
        -->
        <activity
            android:name=".MainActivityP1"
            android:exported="false"
            android:process=":p1"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <activity
            android:name=".MainActivityP2"
            android:exported="false"
            android:process=":p2"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <activity
            android:name=".MainActivityP3"
            android:exported="false"
            android:process=":p3"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="@string/diagnostics_title"
            android:parentActivityName=".SettingsActivity" />

        <!-- Local API (Phần 3): 4 service, mỗi hồ sơ 1 tiến trình riêng khớp
             với Activity của hồ sơ đó, để điều khiển đúng tab đang mở. -->
        <service
            android:name=".api.ApiServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".api.ApiServerServiceP1"
            android:exported="false"
            android:process=":p1"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".api.ApiServerServiceP2"
            android:exported="false"
            android:process=":p2"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".api.ApiServerServiceP3"
            android:exported="false"
            android:process=":p3"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
