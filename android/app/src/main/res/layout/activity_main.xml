<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Thanh tab: cuộn ngang, mỗi tab là 1 chip có icon vuông + nút đóng -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="?attr/chromeBackground"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Thanh địa chỉ: gọn trong 1 hàng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/chromeBackground"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_back"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="centerInside"
            android:padding="7dp"
            app:tint="?attr/iconMuted" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_forward"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="centerInside"
            android:padding="7dp"
            app:tint="?attr/iconMuted" />

        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_reload"
            android:src="@android:drawable/ic_menu_rotate"
            android:scaleType="centerInside"
            android:padding="7dp"
            app:tint="?attr/iconMuted" />

        <EditText
            android:id="@+id/editAddress"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_address_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:hint="@string/hint_address_bar"
            android:textSize="13.5sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?attr/iconMuted" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_voice_search"
            android:src="@android:drawable/ic_btn_speak_now"
            android:scaleType="centerInside"
            android:padding="7dp"
            app:tint="?attr/iconMuted" />

        <ImageButton
            android:id="@+id/btnNewTabTop"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_new_tab"
            android:src="@android:drawable/ic_menu_add"
            android:scaleType="centerInside"
            android:padding="7dp"
            app:tint="?attr/iconMuted" />

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_more"
            android:src="@drawable/ic_overflow"
            android:scaleType="centerInside"
            android:padding="7dp"
            app:tint="?attr/iconMuted" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Thanh điều hướng dưới: bỏ back/forward/reload (đã chuyển lên trên
         cạnh ô địa chỉ, giống mockup) - chỉ giữ số tab + tab mới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/chromeBackground"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        android:weightSum="2">

        <TextView
            android:id="@+id/btnTabCount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="30dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:background="@drawable/bg_tab_count"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:text="1" />

        <ImageButton
            android:id="@+id/btnNewTabBottom"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="24dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_new_tab"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/iconMuted" />

    </LinearLayout>

</LinearLayout>
